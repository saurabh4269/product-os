flowchart TB
  subgraph tenant_y [Product Y — tenant origin]
    COVE[Cove storefront]
    WIRE[Loop wire · flags client]
    COVE --> WIRE
  end

  subgraph signals [Signal plane]
    GA4[GA4 / Ads / PostHog / Firebase]
    LOGS[Cloud Logging]
    CRM[Support / Voice / Reviews]
    GA4 --> BQ[(BigQuery facts)]
    LOGS --> BQ
    CRM --> BQ
    WIRE -->|push ingest| INGEST[Ingest API]
  end

  subgraph agents [Agent plane — ADK 2]
    SIG[Signal]
    INV[Investigator]
    SPEC[Analytics / Logs / Deploy / Voice]
    RCA[Root Cause]
    PATH{BUG vs FEATURE}
    CODE[Code + Test]
    PROD[Product + Experiment]
    RISK[Risk]
    HITL{HIGH HITL gate}
    APR[Approve]
    LEARN[Learning]
    SIG --> INV --> SPEC --> RCA --> PATH
    PATH -->|Type A| CODE --> RISK
    PATH -->|Type B| PROD --> RISK
    RISK --> HITL
    HITL -->|human| APR --> LEARN
    HITL -->|LOW/MED| LEARN
  end

  subgraph hybrid [Hybrid engine]
    LOOP_HOST[Cloud Run loop — deterministic]
    ADK_HOST[Cloud Run loop-adk — optional]
    LOOP_HOST -.-> ADK_HOST
  end

  subgraph security [Security plane]
    ID[Agent Identity]
    GW[Gateway / IAM policies]
    MA[Model Armor]
    SDP[Sensitive Data Protection]
    DENY{Exfil DENY?}
    ID --> GW --> MA --> SDP
    GW --> DENY
    DENY -->|yes| REV[Reviews — blocked]
  end

  subgraph tools [Tool plane]
    GH[GitHub]
    WS[Workspace MCP]
    TEL[Telephony / Live fallback]
    FLAG[Flags / CI]
  end

  subgraph memory [Memory / control]
    RT[Runtime / Cloud Run]
    MB[(Memory Bank — 4 kinds)]
    REG[Registry]
    OTEL[OpenTelemetry traces]
  end

  BQ --> SIG
  INGEST --> SIG
  LEARN --> MB
  MB --> SIG
  REG --> INV
  GW --> CODE
  GW --> PROD
  CODE --> GH
  PROD --> WS
  SPEC --> TEL
  RISK --> FLAG
  RT --> OTEL
  LOOP_HOST --> INV
